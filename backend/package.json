{
  "name": "waveagent-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@metamask/smart-accounts-kit": "^1.6.0",
    "viem": "^2.31.4",
    "venice-x402-client": "^0.2.0",
    "@prisma/client": "^5.22.0",
    "ioredis": "^5.4.0",
    "openai": "^4.77.0",
    "zod": "^3.23.0",
    "pino": "^9.5.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.22.0",
    "dotenv-cli": "^7.4.0",
    "vitest": "^1.6.0",
    "pino-pretty": "^11.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "keccak",
      "bufferutil",
      "utf-8-validate",
      "unrs-resolver"
    ]
  }
}
