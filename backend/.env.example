# ── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Frontend origin allowed by CORS (the Next frontend dev server)
FRONTEND_ORIGIN=http://localhost:3000

# ── Database (Neon — serverless Postgres) ──────────────
DATABASE_URL=postgresql://user:pass@host.neon.tech/waveagent?sslmode=require

# ── Redis (Upstash — TLS, use rediss://) ───────────────
REDIS_URL=rediss://default:token@host.upstash.io:6380

# ── Chain — Base Sepolia ONLY (no mainnet) ─────────────
CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ── Contract (fill in after Phase 2 deploy) ────────────
VENICE_COLLAPSE_ENFORCER_ADDRESS=0x

# ── Wallets ────────────────────────────────────────────
# Backend onchain signer = the initiator that calls the enforcer (initSession +
# submitReasoningHash). Needs a little Base Sepolia ETH for gas. (Reuses the deployer EOA.)
DEPLOYER_PRIVATE_KEY=0x
# Three agent EOAs — used ONLY to derive smart-account addresses and sign sub-delegations
# offchain. They need NO funds (no x402, no onchain txs from them).
AGENT_A_PRIVATE_KEY=0x
AGENT_B_PRIVATE_KEY=0x
AGENT_C_PRIVATE_KEY=0x

# ── Venice AI (REQUIRED — this is the inference path) ──
# Get a key + free credits at https://venice.ai → Settings → API.
VENICE_API_KEY=
# Reasoning ("thinking") model that returns reasoning_content. List: GET api.venice.ai/api/v1/models
# Cheaper alternatives: zai-org-glm-4.7-flash, qwen3-5-35b-a3b
VENICE_MODEL=qwen3-235b-a22b-thinking-2507

# ── x402 (agents pay per-inference toll, settled onchain on Base Sepolia) ──
# Agents pay this much USDC per inference to the gateway. Agent wallets need testnet USDC
# (free: https://faucet.circle.com). Settlement gas is paid by DEPLOYER_PRIVATE_KEY.
X402_PRICE_USDC=$0.01

# ── Basescan (optional — contract verification only) ───
BASESCAN_API_KEY=

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
