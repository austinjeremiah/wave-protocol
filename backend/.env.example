# ── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Database (Neon — serverless Postgres) ──────────────
DATABASE_URL=postgresql://user:pass@host.neon.tech/waveagent?sslmode=require

# ── Redis (Upstash — TLS, use rediss://) ───────────────
REDIS_URL=rediss://default:token@host.upstash.io:6380

# ── Chain — Base Sepolia ONLY (no mainnet) ─────────────
CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ── Contract (fill in after Phase 2 deploy) ────────────
VENICE_COLLAPSE_ENFORCER_ADDRESS=0x

# ── Wallets ────────────────────────────────────────────
# Deployer — needs a little Base Sepolia ETH for contract deploy
DEPLOYER_PRIVATE_KEY=0x
# Three agent EOAs — each needs Base Sepolia USDC for Venice x402 payments
AGENT_A_PRIVATE_KEY=0x
AGENT_B_PRIVATE_KEY=0x
AGENT_C_PRIVATE_KEY=0x

# ── Venice AI ──────────────────────────────────────────
# Primary auth is the agent wallet (x402). API key is a fallback path only.
VENICE_API_KEY=
# Reasoning model id (override if Venice renames it)
VENICE_MODEL=deepseek-r1-671b

# ── 1Shot Relayer ──────────────────────────────────────
# Public webhook URL the relayer calls back (your deployed origin + /api/webhook/1shot)
ONESHOT_WEBHOOK_URL=http://localhost:3001/api/webhook/1shot

# ── Basescan (contract verification) ───────────────────
BASESCAN_API_KEY=

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
