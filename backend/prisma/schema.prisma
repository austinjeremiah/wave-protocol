generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                String        @id @default(cuid())
  sessionId         String        @unique // bytes32 hex — matches the onchain session id
  userAddress       String
  userIntent        String
  budgetUsdc        Float
  status            SessionStatus @default(PENDING)
  permissionContext String? // ERC-7715 root delegation context from the wallet
  delegationManager String?
  accountMetadata   Json? // ERC-7715 grant dependencies [{ factory, factoryData }] — deploys the user's gator on first redeem
  agentDelegations  Json? // the 3 signed sub-delegations (A->B, A->C, A->D)
  agentResults      AgentResult[]
  winnerAgentId     Int?
  winnerHash        String?
  collapseTaskId    String?
  strategyVaultTx   String?   // tx: winner delegation redeem → USDC to WaveStrategyVault
  aaveSupplyTx      String?   // tx: vault.executeStrategy → USDC supplied to Compound V3
  fundedViaDelegation Boolean? // true = ERC-7710 delegation redeem; false = treasury fallback
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userAddress])
  @@index([status])
}

enum SessionStatus {
  PENDING
  DELEGATION_GRANTED
  AGENTS_RUNNING
  AGENTS_DEBATING
  HASHES_SUBMITTED
  COLLAPSED
  EXECUTING
  EXECUTED
  FAILED
}

model AgentResult {
  id                 String   @id @default(cuid())
  sessionId          String
  session            Session  @relation(fields: [sessionId], references: [sessionId])
  agentId            Int
  role               String
  reasoningContent   String   @db.Text
  reasoningHash      String
  confidence         Int
  round1Confidence   Int?     // pre-debate confidence (Round 1)
  revisedConfidence  Int?     // post-debate confidence (Round 2) — submitted onchain
  critiqueText       String?  @db.Text // what this agent said about peers in Round 2
  convictionBetUsdc  Float?   // x402 amount paid in conviction bet (Round 2)
  structuredOutput   Json
  hashTaskId         String?
  hashTxHash         String?
  delegationDisabled Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@unique([sessionId, agentId])
  @@index([sessionId])
}

/// Wave Market — a listed winning strategy (copy-trading). Provenance is verified onchain
/// (WaveMarket.list checks the enforcer); this mirrors it for the UI/feed.
model StrategyListing {
  id            String   @id @default(cuid())
  listingId     Int      @unique // onchain WaveMarket listing id
  sessionId     String // the original collapsed session this strategy came from
  winnerAgentId Int
  reasoningHash String
  sellerAddress String
  priceUsdc     Float // strategy fee per purchase (paid to seller via x402)
  purchases     Int      @default(0)
  active        Boolean  @default(true)
  listTxHash    String?
  createdAt     DateTime @default(now())

  @@index([sellerAddress])
}

/// A purchase of a listed strategy: buyer paid the seller via x402, then the proven strategy
/// was re-executed for the buyer (USDC supplied to Compound V3, credited to the buyer).
model StrategyPurchase {
  id              String   @id @default(cuid())
  listingId       Int
  buyerAddress    String
  deployedUsdc    Float
  sellerPaymentTx String? // x402 settle tx (buyer -> seller)
  supplyTxHash    String? // WaveMarket.purchaseAndExecute -> Compound supplyTo(buyer)
  createdAt       DateTime @default(now())

  @@index([listingId])
  @@index([buyerAddress])
}

model OneShotTask {
  id        String     @id @default(cuid())
  taskId    String     @unique // 1Shot task id
  sessionId String
  purpose   String // "init_session" | "hash_submission" | "disable_delegation" | "execute"
  agentId   Int?
  status    TaskStatus @default(PENDING)
  txHash    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sessionId])
}

enum TaskStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  REJECTED
  REVERTED
}
