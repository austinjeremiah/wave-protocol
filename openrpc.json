          "name": "SendTransactionExample",
          "params": [
            {
              "name": "params",
              "value": {
                "chainId": "8453",
                "payment": {
                  "type": "token",
                  "address": "0x036CbD53842c5426634e7929541eC2318f3dCF7e"
